{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yueguangbai-keyword-image-generator-staging",
  "account_id": "REQUIRED_STAGING_ACCOUNT_ID",
  "main": "src/keyword-image-generator-worker.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "FONT_SC_OBJECT_KEY": "system/keyword-generator/NotoSansSC-VF.otf",
    "FONT_JP_OBJECT_KEY": "system/keyword-generator/NotoSansJP-VF.otf"
  },
  "r2_buckets": [
    {
      "binding": "FONT_BUCKET",
      "bucket_name": "REQUIRED_STAGING_R2_BUCKET_NAME"
    }
  ]
}
