{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "REQUIRED_PRODUCTION_WORKER_NAME",
  "account_id": "REQUIRED_PRODUCTION_ACCOUNT_ID",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "REQUIRED_PRODUCTION_CUSTOM_DOMAIN",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["REQUIRED_PRODUCTION_CRON"]
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "WEB_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENVIRONMENT": "production",
    "APP_RELEASE_SHA": "REQUIRED_RELEASE_COMMIT_SHA",
    "APP_ORIGIN": "REQUIRED_PRODUCTION_HTTPS_ORIGIN",
    "APP_ALLOWED_ORIGINS": "REQUIRED_PRODUCTION_HTTPS_ORIGIN",
    "SCHEDULED_OPERATIONS_ENABLED": "true",
    "SCHEDULED_OPERATIONS_DISABLED_JOBS": "",
    "ACQUISITION_MAINTENANCE_ENABLED": "true",
    "OPERATIONAL_ALERT_MODE": "disabled",
    "SELLER_PRINCIPAL_RATE_ENFORCEMENT_ENABLED": "false",

    "STAFF_ACCESS_TEAM_DOMAIN": "REQUIRED_CLOUDFLARE_ACCESS_TEAM_HTTPS_ORIGIN",
    "STAFF_ACCESS_AUD": "REQUIRED_CLOUDFLARE_ACCESS_APPLICATION_AUD",
    "STAFF_AUTH_ALLOWED_ORIGINS": "REQUIRED_PRODUCTION_HTTPS_ORIGIN",

    "DRIVE_ARCHIVE_ENABLED": "false",
    "DRIVE_ARCHIVE_COPY_ENABLED": "false",
    "DRIVE_ARCHIVE_PROXY_READ_ENABLED": "false",
    "DRIVE_ARCHIVE_R2_DELETE_ENABLED": "false",

    "STAFF_MCP_ENABLED": "false",
    "STAFF_MCP_PRODUCTION_TRANSPORT_ENABLED": "false",
    "STAFF_MCP_LOCAL_MOCK_ENABLED": "false",
    "STAFF_MCP_CLEANUP_ENABLED": "false",
    "STAFF_MCP_CLEANUP_LIMIT": "100",
    "STAFF_MCP_DISABLED_TOOLS": "",
    "STAFF_MCP_ENABLED_TOOLS": "REQUIRED_PRODUCTION_STAFF_MCP_ENABLED_TOOLS",
    "STAFF_MCP_RESOURCE": "REQUIRED_PRODUCTION_STAFF_MCP_RESOURCE",
    "STAFF_MCP_RESOURCE_DOCUMENTATION_URL": "REQUIRED_PRODUCTION_STAFF_MCP_RESOURCE_DOCUMENTATION_URL",
    "STAFF_MCP_RESOURCE_POLICY_URL": "REQUIRED_PRODUCTION_STAFF_MCP_RESOURCE_POLICY_URL",
    "STAFF_MCP_OAUTH_AUDIENCE": "REQUIRED_PRODUCTION_STAFF_MCP_RESOURCE",
    "STAFF_MCP_OAUTH_ISSUER": "REQUIRED_PRODUCTION_STAFF_MCP_OAUTH_ISSUER",
    "STAFF_MCP_OAUTH_METADATA_URL": "REQUIRED_PRODUCTION_STAFF_MCP_OAUTH_METADATA_URL",
    "STAFF_MCP_OAUTH_AUTHORIZATION_ENDPOINT": "REQUIRED_PRODUCTION_STAFF_MCP_OAUTH_AUTHORIZATION_ENDPOINT",
    "STAFF_MCP_OAUTH_TOKEN_ENDPOINT": "REQUIRED_PRODUCTION_STAFF_MCP_OAUTH_TOKEN_ENDPOINT",
    "STAFF_MCP_OAUTH_JWKS_URI": "REQUIRED_PRODUCTION_STAFF_MCP_OAUTH_JWKS_URI",
    "STAFF_MCP_OAUTH_REVOCATION_ENDPOINT": "REQUIRED_PRODUCTION_STAFF_MCP_OAUTH_REVOCATION_ENDPOINT",
    "STAFF_MCP_GLOBAL_RATE_LIMIT_PER_MINUTE": "120",
    "STAFF_MCP_TOOL_RATE_LIMIT_PER_MINUTE": "30",
    "STAFF_MCP_TOKEN_STATUS_TIMEOUT_MS": "3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REQUIRED_PRODUCTION_D1_NAME",
      "database_id": "REQUIRED_PRODUCTION_D1_ID",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILE_OBJECT_STORAGE_R2",
      "bucket_name": "REQUIRED_PRODUCTION_R2_BUCKET_NAME"
    }
  ],
  "services": [
    {
      "binding": "STAFF_MCP_TOKEN_STATUS_SERVICE",
      "service": "REQUIRED_PRODUCTION_STAFF_MCP_TOKEN_STATUS_SERVICE"
    }
  ]
}
