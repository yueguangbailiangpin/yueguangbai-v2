{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "REQUIRED_PRODUCTION_WORKER_NAME",
  "account_id": "REQUIRED_PRODUCTION_ACCOUNT_ID",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "REQUIRED_PRODUCTION_CUSTOM_DOMAIN",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["REQUIRED_PRODUCTION_CRON"]
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "WEB_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENVIRONMENT": "production",
    "APP_RELEASE_SHA": "REQUIRED_RELEASE_COMMIT_SHA",
    "APP_ORIGIN": "REQUIRED_PRODUCTION_HTTPS_ORIGIN",
    "APP_ALLOWED_ORIGINS": "REQUIRED_PRODUCTION_HTTPS_ORIGIN",
    "SCHEDULED_OPERATIONS_ENABLED": "true",
    "SCHEDULED_OPERATIONS_DISABLED_JOBS": "",
    "OPERATIONAL_ALERT_MODE": "bound",
    "OPERATIONAL_ALERT_SINK_SERVICE": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SERVICE",
    "OPERATIONAL_ALERT_SINK_ENTRYPOINT": "OperationalAlertSinkEntrypoint",
    "OPERATIONAL_ALERT_SINK_IDENTITY": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SINK_IDENTITY",
    "OPERATIONAL_ALERT_SINK_DEPLOYMENT_VERSION": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SINK_DEPLOYMENT_VERSION",
    "OPERATIONAL_ALERT_SINK_CONFIG_FINGERPRINT": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SINK_CONFIG_SHA256",

    "STAFF_ACCESS_TEAM_DOMAIN": "REQUIRED_CLOUDFLARE_ACCESS_TEAM_HTTPS_ORIGIN",
    "STAFF_ACCESS_AUD": "REQUIRED_CLOUDFLARE_ACCESS_APPLICATION_AUD",
    "STAFF_AUTH_ALLOWED_ORIGINS": "REQUIRED_PRODUCTION_HTTPS_ORIGIN",

    "ARCHIVE_SELECTOR_ENABLED": "false",
    "ARCHIVE_DRIVE_UPLOAD_ENABLED": "false",
    "ARCHIVE_HOT_DELETE_ENABLED": "false",
    "ARCHIVE_RESTORE_WORKER_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REQUIRED_PRODUCTION_D1_NAME",
      "database_id": "REQUIRED_PRODUCTION_D1_ID",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILE_OBJECT_STORAGE_R2",
      "bucket_name": "REQUIRED_PRODUCTION_R2_BUCKET_NAME"
    }
  ],
  "services": [
    {
      "binding": "OPERATIONAL_ALERT_SINK",
      "service": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SERVICE",
      "entrypoint": "OperationalAlertSinkEntrypoint",
      "props": {
        "service_target": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SERVICE",
        "entrypoint": "OperationalAlertSinkEntrypoint",
        "sink_identity": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SINK_IDENTITY",
        "sink_deployment_version": "REQUIRED_PRODUCTION_OPERATIONAL_ALERT_SINK_DEPLOYMENT_VERSION"
      }
    }
  ]
}
