{
  "name": "yueguangbai-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply yueguangbai-v2-local --local --config apps/api/wrangler.local.jsonc",
    "db:verify": "node scripts/verify-migrations.mjs",
    "verify:migration-guards": "node scripts/verify-migration-version-guards.mjs",
    "verify:phase3i": "node scripts/verify-phase3i-review-metadata.mjs",
    "verify:phase3j": "node scripts/verify-phase3j-seller-payables.mjs",
    "verify:phase3k": "node scripts/verify-phase3k-seller-payments.mjs",
    "verify:seller-finance-security": "node scripts/verify-seller-finance-security.mjs",
    "verify:wave11-dto-isolation": "node scripts/verify-wave11-dto-isolation.mjs",
    "verify:wave11": "npm run verify:phase3i && npm run verify:phase3j && npm run verify:phase3k && npm run verify:seller-finance-security && npm run verify:wave11-dto-isolation",
    "verify:phase3l": "node scripts/verify-phase3l-financial-reporting.mjs",
    "verify:phase3m": "node scripts/verify-phase3m-financial-exports.mjs",
    "verify:wave12:migrations": "node scripts/verify-wave12-migrations.mjs",
    "verify:wave12:formulas": "node scripts/verify-wave12-financial-formulas.mjs",
    "verify:wave12:security": "node scripts/verify-wave12-financial-security.mjs",
    "verify:wave12:dto": "node scripts/verify-wave12-dto-isolation.mjs",
    "verify:wave12": "npm run verify:phase3l && npm run verify:phase3m && npm run verify:wave12:migrations && npm run verify:wave12:formulas && npm run verify:wave12:security && npm run verify:wave12:dto",
    "security:scan": "node scripts/scan-secrets.mjs",
    "check": "npm run security:scan && npm run typecheck && npm run db:verify && npm run verify:migration-guards && npm run verify:wave11 && npm run verify:wave12 && npm test && npm run build",
    "dev:api": "npm --workspace @ygb/api run dev",
    "dev:web": "npm --workspace @ygb/web run dev"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
