    "preflight:cloudflare-release": "node scripts/preflight-cloudflare-release.mjs",
    "dry-run:cloudflare-release": "node scripts/preflight-cloudflare-release.mjs --environment staging && node scripts/preflight-cloudflare-release.mjs --environment production",
    "verify:cloudflare-release": "node scripts/verify-production-cloudflare-web-r2-release-configuration.mjs",
    "verify:web-static-build": "node scripts/verify-web-static-build.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "verify:dependency-lifecycle": "node scripts/verify-dependency-lifecycle.mjs",
    "test:dependency-lifecycle": "node --test scripts/verify-dependency-lifecycle.node-test.mjs",
    "check:ci:static": "npm run verify:openspec:strict && npm run security:scan && npm run audit:dependencies && npm run verify:dependency-lifecycle && npm run test:node-safety && npm run test:final-production-go && npm run typecheck && npm run db:verify && npm run verify:migration-guards && npm run dry-run:cloudflare-release && npm run verify:final-production-go:local",
    "check:ci:test-build": "npm run verify:customer-security && npm run verify:marketplace-money && npm run verify:marketplace-adapters && npm run preflight:marketplace-adapters && npm run verify:wave11 && npm run verify:wave12 && npm run check:wave13:migration && npm run check:wave13:staff-auth && npm run check:wave13:dto && npm run check:wave13:file && npm run check:wave13:price-mismatch && npm run check:wave13:buyer-refund && npm run verify:web-source-boundaries && npm run verify:module1:buyer && npm test && npm run build && npm run verify:web-static-build",
    "check": "npm run check:ci:static && npm run check:ci:test-build",
    "dev:api": "npm --workspace @ygb/api run dev",
    "dev:web": "npm --workspace @ygb/web run dev",
    "preview:web:local": "node scripts/local-production-preview.mjs",
    "measure:web:runtime": "node scripts/measure-frontend-runtime-performance.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.8.0",
    "@types/node": "24.13.3",
    "shell-quote": "1.10.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.116.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.0"
    }
  }
}
