    "check:wave13:dto": "node scripts/verify-wave13-secret-dto.mjs",
    "check:wave13:file": "node scripts/verify-wave13-file-architecture.mjs",
    "check:wave13:price-mismatch": "node scripts/verify-wave13-price-mismatch.mjs",
    "check:wave13:buyer-refund": "node scripts/verify-wave13-buyer-refund-isolation.mjs",
    "verify:customer-security": "node scripts/verify-customer-multipersona-security.mjs",
    "preflight:drive-archive": "node scripts/preflight-google-drive-cold-archive.mjs --environment staging && node scripts/preflight-google-drive-cold-archive.mjs --environment production",
    "verify:staff-mcp": "node scripts/verify-staff-mcp-security.mjs",
    "dry-run:staff-mcp": "node scripts/dry-run-staff-mcp.mjs",
    "test:staff-mcp": "vitest run apps/api/src/staff-mcp packages/contracts/src/staff-mcp.test.ts",
    "preflight:staff-mcp-production": "node scripts/preflight-staff-mcp-production.mjs --environment staging && node scripts/preflight-staff-mcp-production.mjs --environment production",
