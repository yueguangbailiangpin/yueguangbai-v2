{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "yueguangbai-v2-example",
  "account_id": "REPLACE_BEFORE_USE",
  "main": "apps/api/src/worker.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ENVIRONMENT": "REPLACE_BEFORE_USE",
    "APP_ORIGIN": "REPLACE_BEFORE_USE",
    "APP_ALLOWED_ORIGINS": "REPLACE_BEFORE_USE",
    "SCHEDULED_OPERATIONS_ENABLED": "false",
    "SCHEDULED_OPERATIONS_DISABLED_JOBS": "",
    "OPERATIONAL_ALERT_MODE": "disabled",
    // Stage 5 (D-055) cold-archive switches — every one defaults OFF. The D1
    // archive_runtime_controls table is the independent second gate; the
    // release preflight additionally requires all four to stay "false".
    "ARCHIVE_SELECTOR_ENABLED": "false",
    "ARCHIVE_DRIVE_UPLOAD_ENABLED": "false",
    "ARCHIVE_HOT_DELETE_ENABLED": "false",
    "ARCHIVE_RESTORE_WORKER_ENABLED": "false"
    // Stage 6.5 Google Drive HTTP adapter (drive-http-client.ts). The
    // adapter is built from these vars by archiveRuntime(); with
    // ARCHIVE_DRIVE_UPLOAD_ENABLED=false it makes ZERO HTTP requests.
    // Variable names only — the secret values are wrangler-managed secrets:
    //   wrangler secret put GOOGLE_DRIVE_CLIENT_SECRET
    //   wrangler secret put GOOGLE_DRIVE_REFRESH_TOKEN
    // and never plaintext vars. GOOGLE_DRIVE_FOLDER_ID may be a regular
    // folder or a Shared Drive folder id; GOOGLE_DRIVE_SHARED_DRIVE_ID is
    // optional and adds the driveId parameter. The refresh-token triple
    // (client id + secret + refresh token) is the production path;
    // GOOGLE_DRIVE_ACCESS_TOKEN (static token) exists for controlled manual
    // operation only and must NOT be set as a plaintext var.
    // "GOOGLE_DRIVE_FOLDER_ID": "REPLACE_BEFORE_USE",
    // "GOOGLE_DRIVE_SHARED_DRIVE_ID": "REPLACE_BEFORE_USE",
    // "GOOGLE_DRIVE_CLIENT_ID": "REPLACE_BEFORE_USE"
  },
  "compatibility_date": "REPLACE_BEFORE_USE",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "WEB_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_BEFORE_USE",
      "database_id": "REPLACE_BEFORE_USE",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILE_OBJECT_STORAGE_R2",
      "bucket_name": "REPLACE_BEFORE_USE"
    }
  ]
  // Stage 5 Queues TEMPLATE (D-055). No real queue exists in this stage and
  // nothing below is active: when a future change creates the queue it must
  // be created explicitly (`wrangler queues create`) with owner approval.
  // Message bodies carry only bundle_id/bundle_version/job_type/trace_id.
  //
  // "queues": {
  //   "producers": [
  //     { "binding": "ARCHIVE_QUEUE", "queue": "REPLACE_BEFORE_USE" }
  //   ],
  //   "consumers": [
  //     {
  //       "queue": "REPLACE_BEFORE_USE",
  //       "max_batch_size": 5,
  //       "max_batch_timeout": 10,
  //       "max_retries": 8,
  //       "max_concurrency": 3,
  //       "retry_delay": 60,
  //       "dead_letter_queue": "REPLACE_BEFORE_USE-dlq"
  //     }
  //   ]
  // }
}
